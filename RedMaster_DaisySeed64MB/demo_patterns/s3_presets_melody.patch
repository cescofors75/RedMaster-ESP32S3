+// ── Per-pattern track engine + factory preset (recall on pattern switch) ──
+void Sequencer::setTrackEngine(int pattern, int track, int8_t engine) {
+  if (pattern < 0 || pattern >= MAX_PATTERNS) return;
+  if (track < 0 || track >= MAX_TRACKS) return;
+  if (engine < -1 || engine > 8) engine = -1;
+  pd->trackEngine[pattern][track] = engine;
+}
+int8_t Sequencer::getTrackEngine(int pattern, int track) {
+  if (pattern < 0 || pattern >= MAX_PATTERNS) return -1;
+  if (track < 0 || track >= MAX_TRACKS) return -1;
+  return pd->trackEngine[pattern][track];
+}
+void Sequencer::setTrackPreset(int pattern, int track, uint8_t preset) {
+  if (pattern < 0 || pattern >= MAX_PATTERNS) return;
+  if (track < 0 || track >= MAX_TRACKS) return;
+  pd->trackPreset[pattern][track] = preset;
+}
+uint8_t Sequencer::getTrackPreset(int pattern, int track) {
+  if (pattern < 0 || pattern >= MAX_PATTERNS) return 0;
+  if (track < 0 || track >= MAX_TRACKS) return 0;
+  return pd->trackPreset[pattern][track];
+}
